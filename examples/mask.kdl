image width=800 height=600

// A background with a hole punched by an `unmask`.
path {
    unmask {
        path {
            node 380 300
            node 420 300
            gradient 0 {
                stop 0 0 0 0
                stop 20 0 0 0 0
            }
        }
    }
    node 0 0
    node 1 0
    gradient 0 {
        stop 0 0.95 0.02 90
    }
}

// Subtraction: a soft disc with a slot cut out by an `unmask` inside
// its mask.
group {
    mask {
        unmask {
            path {
                node 620 500
                node 740 500
                gradient 0 {
                    stop 0 0 0 0
                    stop 8 0 0 0
                    stop 12 0 0 0 0
                }
            }
        }
        path {
            node 680 500
            node 680.01 500
            gradient 0 {
                stop 0 0 0 0
                stop 60 0 0 0
                stop 80 0 0 0 0
            }
        }
    }
    path {
        node 600 420
        node 760 580
        gradient 1.5 {
            stop 0 0.8 0.15 90
            stop 120 0.6 0.15 30
        }
        gradient 3.5 {
            stop 0 0.6 0.15 300
            stop 120 0.8 0.15 200
        }
    }
}

// Intersection: a vertical band, masked by a mask that is itself masked, so
// it only shows where both a ring and a horizontal band are.
path {
    mask {
        mask {
            path {
                node 0 520
                node 800 520
                gradient 0 {
                    stop 0 0 0 0
                    stop 50 0 0 0
                    stop 60 0 0 0 0
                }
            }
        }
        loop {
            node 120 420
            node 200 500
            node 120 580
            node 40 500
            gradient 1 {
                stop 0 0 0 0
                stop 25 0 0 0 0
            }
            gradient 3 {
                stop 0 0 0 0
                stop 25 0 0 0 0
            }
        }
    }
    node 120 0
    node 120 600
    gradient 0 {
        stop 0 0.7 0.17 150
        stop 200 0.7 0.17 150
    }
}

// A group of two strokes, faded out by a soft round mask.
group {
    mask {
        // Colour is ignored in masks; only alpha matters.
        loop {
            node 400 150
            node 600 300
            node 400 450
            node 200 300
            gradient 1 {
                stop 0 0 0 0
                stop 40 0 0 0 0
            }
            gradient 3 {
                stop 0 0 0 0
            }
        }
    }
    path {
        node 100 350
        node 700 350
        gradient 1.5 {
            stop 0 0.55 0.12 250
            stop 30 0.55 0.12 250 0
        }
    }
    path {
        node 100 250
        node 700 250
        gradient 1.5 {
            stop 0 0.75 0.18 40
            stop 30 0.75 0.18 40 0
        }
    }
}
