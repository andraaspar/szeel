image width=800 height=600

defs {
    // Not drawn by themselves.
    loop id="spot" {
        node 300 200
        node 500 200
        node 400 400
        gradient 1 {
            stop 0 0 0 0
            stop 30 0 0 0 0
        }
        gradient 3 {
            stop 0 0 0 0
        }
    }
    loop id="ring" {
        node 200 300
        node 400 100
        node 600 300
        node 400 500
        gradient 1 {
            stop 0 0.7 0.15 150
            stop 10 0.7 0.15 150 0
        }
    }
}

// A copy of "ring" with an extra mask of its own.
use "ring" {
    unmask {
        use "spot"
    }
}

// The same mask on two different elements.
path {
    mask {
        use "ring"
        use "spot"
    }
    node 0 0
    node 1 0
    gradient 0 {
        stop 0 0.3 0.05 260
    }
}
group {
    mask {
        use "spot"
    }
    path {
        node 0 300
        node 800 300
        gradient 1.5 {
            stop 0 0.6 0.2 20
            stop 50 0.6 0.2 20 0
        }
    }
}

// "ring" itself, in front.
use "ring"
