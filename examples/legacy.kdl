// In the spirit of 2015-11-21.png: one S-shaped path from a red spot to a
// yellow spot. Its left side is above the curve, its right side below it.
// The two sharp diagonal edges are not drawn: they appear where the closest
// point on the path jumps from one arm of a hook to the other.
//
// Each glow is placed on both sides of its end cap (t = 0..1 at the start,
// t = 2..3 at the end), so the cap stays one even, round glow.
image width=1920 height=1080

path {
    point 255 255
    point 300 420
    point 500 390
    point 690 330
    point 770 510

    // Start: red glow in bright blue (spans t = 3.9 → 4 ≡ 0 → 1.1).
    gradient 3.9 {
        stop 0 0.63 0.26 29
        stop 250 0.62 0.21 256
    }
    gradient 1.1 {
        stop 0 0.63 0.26 29
        stop 250 0.62 0.21 256
    }

    // Above the hump: orange fading to pale grey-blue.
    gradient 1.5 {
        stop 0 0.7 0.2 45
        stop 400 0.88 0.03 220
    }

    // End: yellow glow in cream (spans t = 1.9 → 3.1).
    gradient 1.9 {
        stop 0 0.87 0.18 91
        stop 260 0.96 0.05 90
    }
    gradient 3.1 {
        stop 0 0.87 0.18 91
        stop 260 0.96 0.05 90
    }

    // Below the hump: pale pink deepening to navy.
    gradient 3.5 {
        stop 0 0.88 0.05 40
        stop 300 0.3 0.14 262
    }
}
