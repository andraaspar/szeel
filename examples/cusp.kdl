image width=800 height=600

// A `cusp` is a node where the curve may turn sharply instead of passing
// through it smoothly. Each stretch between cusps is its own smooth curve.

// A zig-zag stroke: cusps on every inner node give straight sides.
path {
    node 470 450
    cusp 540 150
    cusp 610 450
    cusp 680 150
    node 750 450
    gradient 1.5 {
        stop 0 0.65 0.2 30
        stop 12 0.65 0.2 30 0
    }
    gradient 3.5 {
        stop 0 0.65 0.2 30
        stop 12 0.65 0.2 30 0
    }
}

// A leaf: a loop with a sharp tip at each end.
loop {
    cusp 120 300
    node 260 220
    cusp 400 300
    node 260 380
    // Inside (right side, the nodes go clockwise): green, darker inward.
    gradient 3.5 {
        stop 0 0.72 0.17 140
        stop 60 0.45 0.12 150
    }
    // Outside: a thin pale glow.
    gradient 1.5 {
        stop 0 0.85 0.1 130
        stop 20 0.95 0.03 130 0
    }
}
