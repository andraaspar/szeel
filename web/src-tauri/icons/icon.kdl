// The app icon. Regenerate the icon set with:
//   cargo run --release -- web/src-tauri/icons/icon.kdl /tmp/icon.png
//   cd web && npx tauri icon /tmp/icon.png -o src-tauri/icons
// then delete the android/, ios/, Square* and StoreLogo files it adds.

image width=1024 height=1024

// The tile: a rounded square, dark inside, nothing outside.
loop {
    node 200 104
    node 512 100
    node 824 104
    node 900 124
    node 920 200
    node 924 512
    node 920 824
    node 900 900
    node 824 920
    node 512 924
    node 200 920
    node 124 900
    node 104 824
    node 100 512
    node 104 200
    node 124 124
    gradient 3 {
        stop 0 0.32 0.05 250
        stop 400 0.2 0.03 275
    }
}

// A spiral stroke, its hue running round the left side.
path {
    node 512 520
    node 590 470
    node 650 560
    node 540 660
    node 400 540
    node 500 360
    node 720 400
    node 760 640
    node 520 800
    node 290 690

    gradient 0 {
        stop 0 0.82 0.14 20
        stop 70 0.82 0.14 20 0
    }
    gradient 1.2 {
        stop 0 0.8 0.16 90
        stop 80 0.8 0.16 90 0
    }
    gradient 1.8 {
        stop 0 0.72 0.18 300
        stop 60 0.72 0.18 300 0
    }
    gradient 3.5 {
        stop 0 0.62 0.12 220
        stop 26 0.62 0.12 220 0
    }
}
