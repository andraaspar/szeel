{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "szeel",
  "mainBinaryName": "szeel-editor",
  "version": "0.1.0",
  "identifier": "dev.szeel.editor",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "szeel",
        "width": 1400,
        "height": 900,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "deb"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Editor for szeel scenes",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "fileAssociations": [
      { "ext": ["kdl"], "name": "szeel scene", "description": "szeel scene", "role": "Editor", "mimeType": "text/x-szeel" }
    ]
  }
}
